{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "my-project-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "my_project.api.main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "my-project-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1"],
      "port": 5173
    }
  ]
}
