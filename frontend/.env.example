# Copy to frontend/.env.local for local overrides. Nothing here is required.

# Logfire for the browser: a write token restricted to this web app. Only production builds on
# Vercel send errors; set it in the Vercel project, not here, unless you test telemetry locally.
# VITE_LOGFIRE_TOKEN=
# VITE_LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
