# Copy to backend/.env for local overrides. Nothing here is required: the defaults work locally.
# Variables of this project start with MY_PROJECT_; DATABASE_URL and LOGFIRE_* are also read.

# MY_PROJECT_ENVIRONMENT=local
# MY_PROJECT_DATABASE_URL=postgresql://my_project:my_project@localhost:5434/my_project
# MY_PROJECT_MIGRATE_ON_START=false

# Logfire: without a token nothing is sent. To send local traces, run `uv run logfire auth` and
# `uv run logfire projects use <project>`, or set a write token:
# LOGFIRE_TOKEN=

# Read token for `uv run my-project obs status` (better kept in ~/.config/my-project/logfire-read-token):
# LOGFIRE_READ_TOKEN=
